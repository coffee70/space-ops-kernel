# Copy to `.env` in this directory (gitignored). Values are substituted by Docker Compose.
#
# Model / LLM keys (never commit real values)
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Mission Control client bundle: browser must reach the platform API from your machine.
# Default matches docker-compose published port for `platform-api` (8000).
# Use empty string only if you rely on same-origin API routes (e.g. Layer 1 edge on :8080 for every tab).
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CONTROL_PLANE_URL=http://localhost:8100

# Optional: SatNOGS / other platform features
SATNOGS_API_TOKEN=
SATNOGS_LIVE_ENABLED=false
