# Copy to `.env` in this directory (gitignored). Values are substituted by Docker Compose.
#
# Model / LLM keys (never commit real values).
OPENAI_API_KEY=

# Optional: OpenRouter enriches catalog metadata only (not required for inference or /models).
OPENROUTER_API_KEY=

# Browser-facing Next.js bundle (Mission Control). Leave empty for normal edge-proxy mode (:8080).
# Same-origin calls use paths like /intelligence/* proxied by platform-edge-proxy.
# Set NEXT_PUBLIC_API_URL=http://localhost:8000 only when running Mission Control directly on :3000
# without the Layer 1 edge proxy.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_CONTROL_PLANE_URL=

# Optional: SatNOGS / other platform features
SATNOGS_API_TOKEN=
SATNOGS_LIVE_ENABLED=false
